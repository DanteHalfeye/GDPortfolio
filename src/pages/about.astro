---

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
? import.meta.env.BASE_URL
: `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
title="About | Eliham Pelaez"
description="About Eliham Pelaez, Gameplay Programmer and Game Designer"

>


<div class="about-page">



	<main class="wrapper about">

		<!-- =====================================================
		     HERO
		====================================================== -->

		<section class="about-hero">
			<div class="hero-copy">
				<div class="eyebrow">
					<span class="eyebrow-dot"></span>
					GAMEPLAY PROGRAMMER / GAME DESIGNER
				</div>

				<Hero
					title="About me."
					tagline="I build gameplay systems, mechanics, and interactive experiences with a focus on programming, game design, and multiplayer."
				/>

				<div class="hero-focus">
					<div class="focus-item">
						<span class="focus-label">PRIMARY FOCUS</span>
						<strong>Gameplay Programming</strong>
					</div>

					<div class="focus-item">
						<span class="focus-label">TECH STACK</span>
						<strong>C# · Unity · UEFN · Verse</strong>
					</div>

					<div class="focus-item">
						<span class="focus-label">LOCATION</span>
						<strong>Medellín, Colombia</strong>
					</div>

					<div class="focus-item">
						<span class="focus-label">GRADUATION</span>
						<strong>February 2027</strong>
					</div>
				</div>
			</div>

			<div class="hero-image">
				<img
					width="1553"
					height="873"
					src={`${base}assets/at-work.jpg`}
					alt="Eliham Pelaez at work"
				/>

				<div class="image-caption">
					<span>ELIHAM PELAEZ</span>
					<span>GAME DEVELOPMENT</span>
				</div>
			</div>
		</section>


		<!-- =====================================================
		     PROFILE
		====================================================== -->

		<section class="about-section profile-section">
			<div class="section-marker">
				<div class="section-number">01</div>
				<div class="section-label">PROFILE</div>
			</div>

			<div class="section-content">
				<div class="section-intro">
					<h2>
						What I do.
					</h2>
				</div>

				<div class="profile-grid">
					<div class="profile-main">
						<p class="lead">
							I am a <strong>Game Design student and Gameplay Programmer </strong>
							focused on building gameplay systems that are clear, responsive,
							and maintainable.
						</p>

						<p class="lead">
							My experience combines technical implementation with game design.
							I enjoy turning ideas into playable systems, from player mechanics
							and progression to enemy behaviors, multiplayer interactions,
							and reusable tools.
						</p>

						<p class="lead">
							I currently study <strong>Game Design at Universidad Pontificia
							Bolivariana (UPB) </strong>, where I work across programming,
							game development, interactive media, and design.
						</p>

						<p class="lead">	
							My recent work with <strong>UEFN and Verse </strong> has expanded
							my experience into multiplayer gameplay, round-based systems,
							enemy management, progression, and device-driven architecture.
						</p>
					</div>

					<div class="profile-sidebar">
						<div class="profile-card">
							<span>ROLE</span>
							<strong>Gameplay Programmer</strong>
						</div>

						<div class="profile-card">
							<span>PROGRAMMING</span>
							<strong>C# · C · JavaScript · Verse</strong>
						</div>

						<div class="profile-card">
							<span>ENGINES</span>
							<strong>Unity · UEFN</strong>
						</div>

						<div class="profile-card">
							<span>INTERESTS</span>
							<strong>Gameplay · Systems · Character AI</strong>
						</div>
					</div>
				</div>

				<div class="statement">
					<span class="statement-mark">“</span>
					<p>
						I want to build games that are
						<strong>meaningful, engaging, and memorable.</strong>
					</p>
				</div>
			</div>
		</section>


		<!-- =====================================================
		     EXPERIENCE
		====================================================== -->

		<section class="about-section">
			<div class="section-marker">
				<div class="section-number">02</div>
				<div class="section-label">EXPERIENCE</div>
			</div>

			<div class="section-content">
				<div class="section-intro">
					<h2>
						How I got
						here.
					</h2>
				</div>

				<div class="timeline">

					<div class="timeline-item featured">
						<div class="timeline-year">2026</div>

						<div class="timeline-content">
							<span class="timeline-tag">RECENT</span>

							<h3>UEFN & Verse</h3>

							<p>
								Expanded into Unreal Editor for Fortnite through the
								UEFN Bootcamp, developing multiplayer gameplay systems,
								round-based game modes, enemy management, progression,
								and cooperative mechanics.
							</p>

							<div class="timeline-skills">
								<span>UEFN</span>
								<span>Verse</span>
								<span>Multiplayer</span>
								<span>Gameplay Systems</span>
							</div>
						</div>
					</div>


					<div class="timeline-item">
						<div class="timeline-year">2021</div>

						<div class="timeline-content">
							<h3>Human Resources Technician</h3>

							<p>
								Developed communication, teamwork, leadership, and
								collaboration skills that complement my technical
								background.
							</p>
						</div>
					</div>


					<div class="timeline-item">
						<div class="timeline-year">2018</div>

						<div class="timeline-content">
							<h3>Game Development & Robotics</h3>

							<p>
								Completed a summer program at EAFIT focused on game
								development and robotics, continuing my exploration
								of programming and interactive media.
							</p>
						</div>
					</div>


					<div class="timeline-item">
						<div class="timeline-year">EARLY</div>

						<div class="timeline-content">
							<h3>Programming & Game Development</h3>

							<p>
								Started experimenting with programming and game creation
								at an early age, including teaching classmates Scratch
								and developing my first projects with Unity and C#.
							</p>
						</div>
					</div>

				</div>
			</div>
		</section>


		<!-- =====================================================
		     EDUCATION
		====================================================== -->

		<section class="about-section">
			<div class="section-marker">
				<div class="section-number">03</div>
				<div class="section-label">EDUCATION</div>
			</div>

			<div class="section-content">
				<div class="section-intro">
					<h2>
						What I've
						learned.
					</h2>
				</div>

				<div class="education">

					<div class="education-item featured">
						<div class="education-year">2027</div>

						<div class="education-info">
							<span class="education-tag">CURRENT</span>

							<strong>B.A. in Game Design</strong>

							<span>
								Universidad Pontificia Bolivariana (UPB)
							</span>

							<small>
								Expected graduation: February 2027 · GPA: 4.3
							</small>
						</div>
					</div>


					<div class="education-item">
						<div class="education-year">2026</div>

						<div class="education-info">
							<strong>Epic Games UEFN Bootcamp</strong>

							<span>
								Verse · Multiplayer · Gameplay Systems
							</span>
						</div>
					</div>


					<div class="education-item">
						<div class="education-year">2021</div>

						<div class="education-info">
							<strong>Human Resources Technician</strong>

							<span>SENA</span>
						</div>
					</div>


					<div class="education-item">
						<div class="education-year">2019</div>

						<div class="education-info">
							<strong>Musical Introduction Certification</strong>

							<span>Atempo</span>
						</div>
					</div>


					<div class="education-item">
						<div class="education-year">2018</div>

						<div class="education-info">
							<strong>Game Development Summer Camp</strong>

							<span>
								EAFIT · Game Development & Robotics
							</span>
						</div>
					</div>

				</div>
			</div>
		</section>


		<!-- =====================================================
		     SKILLS
		====================================================== -->

		<section class="about-section">
			<div class="section-marker">
				<div class="section-number">04</div>
				<div class="section-label">SKILLS</div>
			</div>

			<div class="section-content">
				<div class="section-intro">
					<h2>
						Mytoolkit.
					</h2>
				</div>

				<div class="skills">

					<div class="skill-group featured-skill">
						<div class="skill-number">01</div>

						<h3>Gameplay Programming</h3>

						<p>
							Player mechanics, gameplay systems, enemy systems,
							progression, interactions, game-state logic, and
							reusable gameplay architecture.
						</p>

						<div class="skill-tags">
							<span>C#</span>
							<span>Verse</span>
							<span>Unity</span>
							<span>UEFN</span>
						</div>
					</div>


					<div class="skill-group">
						<div class="skill-number">02</div>

						<h3>Game Development</h3>

						<p>
							Unity, Unreal Engine, UEFN, multiplayer gameplay,
							interactive experiences, prototyping, and systems integration.
						</p>
					</div>


					<div class="skill-group">
						<div class="skill-number">03</div>

						<h3>Programming</h3>

						<p>
							C#, C++, JavaScript, Verse, pseudocode, object-oriented
							programming, and gameplay scripting.
						</p>
					</div>


					<div class="skill-group">
						<div class="skill-number">04</div>

						<h3>Game Design</h3>

						<p>
							Gameplay design, level design, prototyping, user flows,
							wireframing, systems design, and art direction.
						</p>
					</div>


					<div class="skill-group">
						<div class="skill-number">05</div>

						<h3>Creative Coding</h3>

						<p>
							p5.js, Three.js, WebGPU, interactive programming,
							real-time graphics, and procedural experiments.
						</p>
					</div>


					<div class="skill-group">
						<div class="skill-number">06</div>

						<h3>Interactive Media</h3>

						<p>
							OSC, TouchDesigner, Spout, Arduino, Raspberry Pi,
							and networked interactive experiences.
						</p>
					</div>


					<div class="skill-group">
						<div class="skill-number">07</div>

						<h3>Tools</h3>

						<p>
							Git, Git LFS, Figma, Blender, Maya, Photoshop,
							Illustrator, Aseprite, Notion, Miro, and Excel.
						</p>
					</div>


					<div class="skill-group">
						<div class="skill-number">08</div>

						<h3>Collaboration</h3>

						<p>
							Cross-functional collaboration, communication,
							leadership, design thinking, agile development,
							and public speaking.
						</p>
					</div>


					<div class="skill-group">
						<div class="skill-number">09</div>

						<h3>Languages</h3>

						<p>
							<strong>Spanish</strong> — Native<br />
							<strong>English</strong> — Fluent C1
						</p>
					</div>


					<div class="skill-group">
						<div class="skill-number">10</div>

						<h3>Currently Exploring</h3>

						<p>
							Advanced gameplay systems, multiplayer architecture,
							technical game development, and real-time graphics.
						</p>
					</div>

				</div>
			</div>
		</section>

	</main>

	<ContactCTA />
</div>

</BaseLayout>

<style>

/* ==========================================================
   PAGE
========================================================== */

.about-page {
	display: flex;
	flex-direction: column;
	gap: 8rem;
}

.about {
	display: flex;
	flex-direction: column;
	gap: 9rem;
}


/* ==========================================================
   HERO
========================================================== */

.about-hero {
	display: grid;
	grid-template-columns: 1fr 0.8fr;
	align-items: center;
	gap: 5rem;
	min-height: 65vh;
}

.hero-copy {
	display: flex;
	flex-direction: column;
	gap: 1.5rem;
}

.eyebrow {
	display: flex;
	align-items: center;
	gap: 0.7rem;
	font-family: var(--font-mono, monospace);
	font-size: 0.7rem;
	font-weight: 700;
	letter-spacing: 0.14em;
	color: var(--gray-400);
}

.eyebrow-dot {
	width: 7px;
	height: 7px;
	border-radius: 50%;
	background: var(--theme-accent);
	box-shadow: 0 0 12px var(--theme-accent);
}

.hero-image {
	position: relative;
}

.hero-image img {
	display: block;
	width: 100%;
	height: auto;
	margin: 0;
	border-radius: 2rem;
	box-shadow: var(--shadow-md);
}

.image-caption {
	display: flex;
	justify-content: space-between;
	gap: 1rem;
	margin-top: 0.75rem;
	font-family: var(--font-mono, monospace);
	font-size: 0.6rem;
	letter-spacing: 0.08em;
	color: var(--gray-500);
}


/* ==========================================================
   HERO FOCUS
========================================================== */

.hero-focus {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 0;
	margin-top: 1rem;
	border-top: 1px solid var(--gray-800);
	border-bottom: 1px solid var(--gray-800);
}

.focus-item {
	display: flex;
	flex-direction: column;
	gap: 0.35rem;
	padding: 1.2rem 1.25rem;
	border-bottom: 1px solid var(--gray-800);
}

.focus-item:nth-child(odd) {
	border-right: 1px solid var(--gray-800);
}

.focus-item:nth-child(3),
.focus-item:nth-child(4) {
	border-bottom: none;
}

.focus-label {
	font-family: var(--font-mono, monospace);
	font-size: 0.55rem;
	font-weight: 700;
	letter-spacing: 0.12em;
	color: var(--gray-500);
}

.focus-item strong {
	font-size: 0.9rem;
	line-height: 1.4;
	color: var(--gray-100);
}


/* ==========================================================
   SECTION STRUCTURE
========================================================== */

.about-section {
	display: grid;
	grid-template-columns: 180px minmax(0, 1fr);
	gap: 4rem;
	align-items: start;
}

.section-marker {
	position: sticky;
	top: 3rem;
	display: flex;
	flex-direction: column;
	gap: 0.7rem;
}

.section-number {
	font-family: var(--font-mono, monospace);
	font-size: 2.75rem;
	font-weight: 700;
	line-height: 1;
	letter-spacing: -0.08em;
	color: var(--theme-accent);
}

.section-label {
	font-family: var(--font-mono, monospace);
	font-size: 0.75rem;
	font-weight: 700;
	letter-spacing: 0.12em;
	color: var(--gray-200);
}

.section-marker::after {
	content: '';
	width: 3rem;
	height: 2px;
	margin-top: 0.2rem;
	background: var(--theme-accent);
}

.section-content {
	min-width: 0;
}

.section-intro {
	margin-bottom: 3.5rem;
}

.section-intro h2 {
	max-width: 800px;
	margin: 0;
	font-size: clamp(3.5rem, 7vw, 7rem);
	line-height: 0.85;
	letter-spacing: -0.065em;
	color: var(--gray-0);
}

.section-intro h2 em {
	font-style: normal;
	color: var(--theme-accent);
}


/* ==========================================================
   PROFILE
========================================================== */

.profile-grid {
	display: grid;
	grid-template-columns: minmax(0, 1.4fr) minmax(240px, 0.6fr);
	gap: 5rem;
	max-width: 1100px;
}

.profile-main {
	max-width: 720px;
}

.profile-main p {
	margin: 0 0 1.5rem;
	font-size: 1.05rem;
	line-height: 1.7;
	color: var(--gray-400);
}

.profile-main .lead {
	font-size: clamp(1.25rem, 2vw, 1.55rem);
	line-height: 1.55;
	color: var(--gray-200);
}

.profile-main strong {
	color: var(--gray-0);
	font-weight: 600;
}

.profile-sidebar {
	display: flex;
	flex-direction: column;
	border-top: 1px solid var(--gray-700);
}

.profile-card {
	display: flex;
	flex-direction: column;
	gap: 0.45rem;
	padding: 1rem 0;
	border-bottom: 1px solid var(--gray-700);
}

.profile-card span {
	font-family: var(--font-mono, monospace);
	font-size: 0.55rem;
	font-weight: 700;
	letter-spacing: 0.12em;
	color: var(--gray-500);
}

.profile-card strong {
	font-size: 0.9rem;
	line-height: 1.45;
	color: var(--gray-100);
}

.statement {
	position: relative;
	max-width: 900px;
	margin-top: 4rem;
	padding: 2rem 2.5rem;
	border-left: 3px solid var(--theme-accent);
	background:
		linear-gradient(
			135deg,
			rgba(224, 4, 4, 0.045),
			rgba(255, 59, 59, 0.015)
		);
	box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.statement-mark {
	position: absolute;
	top: 0.4rem;
	left: 0.75rem;
	font-family: Georgia, serif;
	font-size: 3rem;
	line-height: 1;
	color: var(--theme-accent);
	opacity: 0.45;
}

.statement p {
	margin: 0;
	padding-left: 0.75rem;
	font-size: clamp(1.25rem, 2.5vw, 1.8rem);
	line-height: 1.35;
	color: var(--gray-200);
}

.statement strong {
	color: var(--theme-accent);
}


/* ==========================================================
   TIMELINE
========================================================== */

.timeline {
	display: flex;
	flex-direction: column;
	max-width: 1000px;
	border-top: 1px solid var(--gray-700);
}

.timeline-item {
	display: grid;
	grid-template-columns: 100px minmax(0, 1fr);
	gap: 2rem;
	padding: 2rem 0;
	border-bottom: 1px solid var(--gray-700);
}

.timeline-item.featured {
	padding: 2.25rem 1.5rem;
	border: 1px solid var(--gray-600);
	border-radius: 1rem;
	background: rgba(255, 255, 255, 0.025);
}

.timeline-year {
	padding-top: 0.25rem;
	font-family: var(--font-mono, monospace);
	font-size: 0.75rem;
	font-weight: 700;
	letter-spacing: 0.08em;
	color: var(--gray-500);
}

.timeline-item.featured .timeline-year {
	color: var(--theme-accent);
}

.timeline-content {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}

.timeline-tag {
	width: fit-content;
	margin-bottom: 0.25rem;
	padding: 0.25rem 0.5rem;
	border: 1px solid var(--theme-accent);
	border-radius: 999px;
	font-family: var(--font-mono, monospace);
	font-size: 0.5rem;
	font-weight: 700;
	letter-spacing: 0.12em;
	color: var(--theme-accent);
}

.timeline-content h3 {
	margin: 0;
	font-size: 1.3rem;
	line-height: 1.3;
	color: var(--gray-0);
}

.timeline-content p {
	max-width: 700px;
	margin: 0;
	font-size: 0.95rem;
	line-height: 1.65;
	color: var(--gray-400);
}

.timeline-skills {
	display: flex;
	flex-wrap: wrap;
	gap: 0.45rem;
	margin-top: 0.75rem;
}

.timeline-skills span {
	padding: 0.35rem 0.6rem;
	border: 1px solid var(--gray-700);
	border-radius: 999px;
	font-family: var(--font-mono, monospace);
	font-size: 0.55rem;
	letter-spacing: 0.04em;
	color: var(--gray-400);
}


/* ==========================================================
   EDUCATION
========================================================== */

.education {
	display: flex;
	flex-direction: column;
	max-width: 1000px;
	border-top: 1px solid var(--gray-700);
}

.education-item {
	display: grid;
	grid-template-columns: 90px minmax(0, 1fr);
	gap: 2rem;
	padding: 1.5rem 0;
	border-bottom: 1px solid var(--gray-700);
}

.education-item.featured {
	margin-bottom: 0;
	padding: 2rem 1.5rem;
	border: 1px solid var(--gray-600);
	border-radius: 1rem;
	background: rgba(255, 255, 255, 0.025);
}

.education-year {
	padding-top: 0.2rem;
	font-family: var(--font-mono, monospace);
	font-size: 0.75rem;
	font-weight: 700;
	letter-spacing: 0.08em;
	color: var(--gray-500);
}

.education-item.featured .education-year {
	color: var(--theme-accent);
}

.education-info {
	display: flex;
	flex-direction: column;
	gap: 0.4rem;
}

.education-info strong {
	font-size: 1.2rem;
	line-height: 1.4;
	color: var(--gray-0);
}

.education-info span {
	font-size: 0.9rem;
	color: var(--gray-400);
}

.education-info small {
	margin-top: 0.15rem;
	font-size: 0.8rem;
	color: var(--gray-500);
}

.education-tag {
	width: fit-content;
	margin-bottom: 0.15rem;
	padding: 0.25rem 0.55rem;
	border: 1px solid var(--theme-accent);
	border-radius: 999px;
	font-family: var(--font-mono, monospace);
	font-size: 0.5rem !important;
	font-weight: 700;
	letter-spacing: 0.12em;
	color: var(--theme-accent) !important;
}


/* ==========================================================
   SKILLS
========================================================== */

.skills {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 0.75rem;
	max-width: 1100px;
}

.skill-group {
	position: relative;
	min-height: 175px;
	padding: 1.5rem;
	overflow: hidden;
	border: 1px solid var(--gray-700);
	border-radius: 1rem;
	background: rgba(255, 255, 255, 0.02);
	transition:
		transform 0.2s ease,
		border-color 0.2s ease,
		background 0.2s ease;
}

.skill-group:hover {
	transform: translateY(-3px);
	border-color: var(--gray-500);
	background: rgba(255, 255, 255, 0.035);
}

.skill-number {
	position: absolute;
	top: 1rem;
	right: 1.25rem;
	font-family: var(--font-mono, monospace);
	font-size: 0.65rem;
	font-weight: 700;
	letter-spacing: 0.1em;
	color: var(--gray-600);
}

.skill-group h3 {
