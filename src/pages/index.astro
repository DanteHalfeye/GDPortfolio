---

import { getCollection } from 'astro:content';

// Component Imports
import CallToAction from '../components/CallToAction.astro';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';

// Layout
import BaseLayout from '../layouts/BaseLayout.astro';

// Content
const projects = (await getCollection('work'))
.sort(
(a, b) =>
b.data.publishDate.valueOf() -
a.data.publishDate.valueOf(),
)
.slice(0, 4);

// GitHub Pages base path
const base = import.meta.env.BASE_URL.endsWith('/')
? import.meta.env.BASE_URL
: `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
	<div class="stack gap-18 lg:gap-45">

	<!-- =====================================================
	     HERO
	====================================================== -->

	<div class="wrapper stack gap-8 lg:gap-20">
		<header class="hero">

			<div class="hero-content">
				<Hero
					title="Eliham Pelaez"
					tagline="Gameplay Programmer specializing in gameplay systems, mechanics, multiplayer interactions, and interactive experiences."
					align="start"
				>
					<div class="roles">

						<Pill>
							<Icon
								icon="code"
								size="1.33em"
							/>
							Gameplay Programmer
						</Pill>

						<Pill>
							<Icon
								icon="game-controller-2"
								size="1.33em"
							/>
							C# · Unity
						</Pill>

						<Pill>
							<Icon
								icon="crosshair"
								size="1.33em"
							/>
							Unreal · UEFN · Verse
						</Pill>

					</div>
				</Hero>


				<div class="hero-actions">

					<CallToAction href={`work/`}>
						<span>View My Work</span>

						<Icon
							icon="arrow-right"
							size="1.2em"
						/>
					</CallToAction>

					<CallToAction href={`/assets/Eliham-Pelaez-CV.pdf`}>
						<span>Download CV</span>
					</CallToAction>

				</div>


				<div class="hero-meta">

					<span>
						Medellín, Colombia
					</span>

					<span class="meta-divider">
						•
					</span>

					<span>
						B.A. Game Development · 2027
					</span>

				</div>
			</div>


			<img
				alt="Portrait of Eliham Pelaez"
				width="100%"
				height="100%"
				src={`${base}assets/portrait.jpg`}
			/>

		</header>


		<!-- =================================================
		     SKILLS
		================================================== -->

		<Skills />

	</div>



	<!-- =====================================================
	     SELECTED WORK
	====================================================== -->

	<main class="work-wrapper">

		<section
			class="work-section with-background"
			aria-labelledby="work-title"
		>

			<!-- =================================================
			     SECTION INTRO
			================================================== -->

			<header class="work-header">

				<div class="work-kicker">

					<span class="kicker-line"></span>

					<span>
						SELECTED WORK
					</span>

					<span class="kicker-year">
						04 PROJECTS
					</span>

				</div>


				<div class="work-heading">

					<div>

						<h2 id="work-title">
							Selected
							<em> work.</em>
						</h2>

					</div>


					<div class="work-intro">

						<p>
							Gameplay programming and game design
							projects focused on mechanics,
							systems, multiplayer, and tools.
						</p>


						<div class="project-count">

							<span class="count-number">
								{String(projects.length).padStart(2, '0')}
							</span>

							<span class="count-label">
								FEATURED PROJECTS
							</span>

						</div>

					</div>

				</div>


				<div class="work-divider"></div>

			</header>



			<!-- =================================================
			     PROJECT GRID
			================================================== -->

			<div class="gallery">

				<Grid variant="offset">

					{
						projects.map((project, index) => (

							<li>

								<div class="project-wrapper">

									<div
										class="project-index"
										aria-hidden="true"
									>
										{String(index + 1).padStart(2, '0')}
									</div>


									<PortfolioPreview
										project={project}
									/>

								</div>

							</li>

						))
					}

				</Grid>

			</div>



			<!-- =================================================
			     CTA
			================================================== -->

			<div class="work-footer">

				<div class="footer-line"></div>


				<div class="footer-content">

					<div>

						<span class="footer-label">
							WANT TO SEE MORE?
						</span>

						<p>
							Explore the complete archive
							of my projects and experiments.
						</p>

					</div>


					<CallToAction href={`work/`}>

						View All Projects

						<Icon
							icon="arrow-right"
							size="1.2em"
						/>

					</CallToAction>

				</div>

			</div>

		</section>

	</main>



	<!-- =====================================================
	     CONTACT
	====================================================== -->

	<ContactCTA />

</div>

</BaseLayout>

<style>
	/* ==========================================================
	   HERO
	========================================================== */

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.hero-content {
		width: 100%;
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.hero img {
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}



	/* ==========================================================
	   HERO ACTIONS
	========================================================== */

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 1.75rem;
	}

	.hero-actions :global(a) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;

		min-height: 58px;
		padding: 1rem 1.5rem;

		border-radius: 0.8rem;

		font-family: var(--font-brand);
		font-size: 1rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		text-decoration: none;

		transition:
			transform 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}



	/* ==========================================================
	   VIEW MY WORK
	   PRIMARY RED ACTION
	========================================================== */

	.hero-actions :global(a:first-child) {
		background: var(--accent-dark) !important;
		color: white !important;

		border: 1px solid var(--accent-dark) !important;

		box-shadow:
			0 0 30px rgba(239, 68, 68, 0.22);
	}

	.hero-actions :global(a:first-child:hover) {
		background: var(--accent-dark) !important;
		color: var(--gray-0) !important;

		transform: translateY(-3px);

		box-shadow:
			0 0 45px rgba(239, 68, 68, 0.4);
	}



	/* ==========================================================
	   DOWNLOAD CV
	   SECONDARY OUTLINE ACTION
	========================================================== */

	.hero-actions :global(a:last-child) {
		background: white !important;
		color:red !important;

		border: 1px solid var(--gray-600) !important;

		box-shadow: none !important;
	}

	.hero-actions :global(a:last-child:hover) {
		background: var(--gray-800) !important;
		color: var(--gray-0) !important;

		border-color: var(--gray-400) !important;

		transform: translateY(-3px);

		box-shadow:
			0 0 25px rgba(255, 255, 255, 0.08) !important;
	}



	/* ==========================================================
	   HERO META
	========================================================== */

	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: 1.25rem;

		font-family:
			var(--font-mono),
			monospace;

		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-500);
	}

	.meta-divider {
		opacity: 0.5;
	}



	/* ==========================================================
	   HERO DESKTOP
	========================================================== */

	@media (min-width: 50em) {

		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
			align-items: center;
		}

		.hero img {
			aspect-ratio: 5 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}

		.hero-actions {
			margin-top: 2rem;
			gap: 1rem;
		}

		.hero-actions :global(a) {
			min-height: 62px;
			padding: 1rem 1.6rem;
			font-size: 1.05rem;
		}
	}



	/* ==========================================================
	   WORK WRAPPER
	========================================================== */

	.work-wrapper {
		width: 100%;
		max-width: none;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	@media (min-width: 50em) {

		.work-wrapper {
			width: min(
				1500px,
				calc(100vw - 4rem)
			);

			max-width: none;
			padding-inline: 0;
		}
	}



	/* ==========================================================
	   WORK SECTION
	========================================================== */

	.work-section {
		position: relative;
		display: grid;
		gap: 4rem;
		width: 100%;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';

		position: absolute;
		pointer-events: none;

		left: 50%;
		width: 100vw;

		aspect-ratio:
			calc(
				2.25 /
				var(--bg-scale)
			);

		top: 0;

		transform:
			translateY(-75%)
			translateX(-50%);

		background:
			url('/GDPortfolio/assets/backgrounds/noise.png')
				top center /
				220px
				repeat,

			var(--hero-bg)
				center center /
				var(--bg-gradient-size)
				no-repeat,

			var(--gray-999);

		background-blend-mode:
			overlay,
			normal,
			normal;

		mix-blend-mode:
			var(--bg-blend-mode);

		z-index: -1;
	}



	/* ==========================================================
	   WORK HEADER
	========================================================== */

	.work-header {
		width: 100%;
	}

	.work-kicker {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;

		font-family:
			var(--font-mono),
			monospace;

		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.kicker-line {
		display: block;
		width: 2.5rem;
		height: 1px;
		background: currentColor;
		opacity: 0.5;
	}

	.kicker-year {
		margin-left: auto;
		opacity: 0.45;
	}



	/* ==========================================================
	   HEADING
	========================================================== */

	.work-heading {
		display: grid;
		gap: 2rem;
	}

	.work-heading h2 {
		margin: 0;
		max-width: 900px;

		font-size:
			clamp(
				3.5rem,
				8vw,
				8rem
			);

		line-height: 0.82;
		letter-spacing: -0.065em;
	}

	.work-heading h2 em {
		font-style: normal;
		opacity: 0.35;
	}

	.work-intro {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 1.5rem;
	}

	.work-intro p {
		max-width: 42ch;
		margin: 0;

		font-size:
			clamp(
				1rem,
				1.5vw,
				1.2rem
			);

		line-height: 1.6;
		color: var(--gray-400);
	}



	/* ==========================================================
	   PROJECT COUNT
	========================================================== */

	.project-count {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;

		font-family:
			var(--font-mono),
			monospace;
	}

	.count-number {
		font-size: 1.5rem;
		letter-spacing: -0.05em;
	}

	.count-label {
		font-size: 0.6rem;
		letter-spacing: 0.12em;
		color: var(--gray-500);
	}



	/* ==========================================================
	   DIVIDER
	========================================================== */

	.work-divider {
		width: 100%;
		height: 1px;
		margin-top: 2rem;
		background: var(--gray-800);
	}



	/* ==========================================================
	   GALLERY
	========================================================== */

	.gallery {
		width: 100%;
		min-width: 0;
	}

	.project-wrapper {
		position: relative;
		width: 100%;
	}

	.project-index {
		position: absolute;
		top: -2rem;
		left: 0;

		font-family:
			var(--font-mono),
			monospace;

		font-size: 0.6rem;
		letter-spacing: 0.12em;
		color: var(--gray-500);

		z-index: 5;
		pointer-events: none;
	}



	/* ==========================================================
	   FOOTER / CTA
	========================================================== */

	.work-footer {
		width: 100%;
		margin-top: 2rem;
	}

	.footer-line {
		width: 100%;
		height: 1px;
		background: var(--gray-800);
	}

	.footer-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding-top: 2rem;
	}

	.footer-label {
		font-size: 3rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.footer-content p {
		margin: 0;
		font-size: 1.95rem;
		color: var(--gray-400);
	}



	/* Bigger View All Projects button */

	.work-footer :global(a) {
		font-size: 1.25rem;
		padding: 1.25rem 2rem;
	}



	/* ==========================================================
	   DESKTOP
	========================================================== */

	@media (min-width: 50em) {

		.work-section {
			gap: 5rem;
		}

		.work-heading {
			grid-template-columns:
				minmax(0, 1.7fr)
				minmax(280px, 0.7fr);

			align-items: end;
			gap: 5rem;
		}

		.work-heading h2 {
			font-size:
				clamp(
					5rem,
					8vw,
					8rem
				);
		}

		.work-intro {
			padding-bottom: 0.5rem;
		}

		.work-divider {
			margin-top: 1rem;
		}

		.project-index {
			top: -2.25rem;
		}

		.work-footer :global(a) {
			font-size: 2.5rem;
			padding: 1.5rem 2.5rem;
		}
	}



	/* ==========================================================
	   MOBILE
	========================================================== */

	@media (max-width: 49.99em) {

		.work-section {
			gap: 3rem;
		}

		.work-kicker {
			margin-bottom: 1.25rem;
		}

		.work-heading h2 {
			font-size:
				clamp(
					3.2rem,
					15vw,
					5rem
				);
		}

		.work-intro {
			margin-top: 1rem;
		}

		.work-intro p {
			font-size: 0.95rem;
		}

		.project-index {
			top: -1.5rem;
		}

		.footer-content {
			flex-direction: column;
			align-items: flex-start;
		}

		.footer-label {
			font-size: 2rem;
		}

		.footer-content p {
			font-size: 1.1rem;
			line-height: 1.5;
		}


		/* Mobile hero buttons */

		.hero-actions {
			width: 100%;
		}

		.hero-actions :global(a) {
			flex: 1;
		}
	}



	/* ==========================================================
	   MENTION CARD
	========================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;

		border:
			1px solid
			var(--gray-800);

		border-radius: 1.5rem;

		color: var(--gray-300);

		background:
			var(--gradient-subtle);

		box-shadow:
			var(--shadow-sm);
	}

	@media (min-width: 50em) {

		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
