    ---
    import type { CollectionEntry } from 'astro:content';

    interface Props {
        data: CollectionEntry<'work'>['data'];
    }

    const { data } = Astro.props;

    const base = import.meta.env.BASE_URL.endsWith('/')
        ? import.meta.env.BASE_URL
        : `${import.meta.env.BASE_URL}/`;

    function resolveAssetPath(path: string | undefined | null) {
        if (!path) return '';

        if (/^(https?:|\/\/|mailto:|tel:|data:|#)/i.test(path)) {
            return path;
        }

        if (path.startsWith(base)) {
            return path;
        }

        const cleanPath = path
            .replace(/^(?:\.\.\/|\.\/)+/, '')
            .replace(/^public\//, '')
            .replace(/^\/+/, '');

        return `${base}${cleanPath}`;
    }

    const heroVideo = data.heroVideo
        ? resolveAssetPath(data.heroVideo)
        : '';

    const featuredImages = data.featuredImages ?? [];
    const gallery = data.gallery ?? [];
    const playUrl = data.playUrl;
    ---

    <div class="project-page">

        <!-- =========================================
            HERO
        ========================================== -->

        <section class="hero">

            {heroVideo && (
                <div class="hero-video">
                    <video
                        autoplay
                        muted
                        loop
                        playsinline
                        poster={data.img ? resolveAssetPath(data.img) : undefined}
                    >
                        <source src={heroVideo} type="video/mp4" />
                    </video>

                    <div class="hero-overlay"></div>
                    <div class="hero-scanline"></div>
                </div>
            )}

            <div class="hero-content">

                <div class="hero-eyebrow">
                    <span class="status-dot"></span>
                    GAME DEVELOPMENT PROJECT
                </div>

                <h1>{data.title}</h1>

                {data.tags && data.tags.length > 0 && (
                    <div class="hero-tags">
                        {data.tags.map((tag) => (
                            <span class="hero-tag">{tag}</span>
                        ))}
                    </div>
                )}

                <p class="hero-description">
                    {data.description}
                </p>

                {playUrl && (
                    <a
                        class="play-button"
                        href={playUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="play-symbol">▶</span>
                        <span>PLAY PROJECT</span>
                        <span class="arrow">↗</span>
                    </a>
                )}

            </div>

            <div class="hero-corner hero-corner-tl"></div>
            <div class="hero-corner hero-corner-tr"></div>
            <div class="hero-corner hero-corner-bl"></div>
            <div class="hero-corner hero-corner-br"></div>

        </section>


        <!-- =========================================
            PROJECT METADATA
        ========================================== -->

        <section class="metadata">

            <div class="meta-item">
                <span class="meta-number">01</span>
                <span class="meta-label">ROLE</span>
                <strong>{data.role || '—'}</strong>
            </div>

            <div class="meta-item">
                <span class="meta-number">02</span>
                <span class="meta-label">ENGINE</span>
                <strong>{data.engine || '—'}</strong>
            </div>

            <div class="meta-item">
                <span class="meta-number">03</span>
                <span class="meta-label">LANGUAGE</span>
                <strong>{data.language || '—'}</strong>
            </div>

            <div class="meta-item">
                <span class="meta-number">04</span>
                <span class="meta-label">PROJECT TYPE</span>
                <strong>{data.projectType || '—'}</strong>
            </div>

        </section>


        <!-- =========================================
            FEATURED IMAGES
        ========================================== -->

        {featuredImages.length > 0 && (
            <section class="featured-images">

                {featuredImages.map((image, index) => (
                    <figure class={`featured-image featured-${index + 1}`}>

                        <img
                            src={resolveAssetPath(image.src)}
                            alt={image.alt}
                            loading="lazy"
                        />

                        <figcaption>
                            <span>0{index + 1}</span>
                            {image.alt}
                        </figcaption>

                    </figure>
                ))}

            </section>
        )}


        <!-- =========================================
            CONTENT
        ========================================== -->

        <main class="project-content">

            <div class="content-inner">

                <div class="content-marker">
                    <span>CASE STUDY</span>
                    <div></div>
                </div>

                <article class="markdown-content">
                    <slot />
                </article>

            </div>

        </main>


        <!-- =========================================
            GALLERY
            NO CAPTIONS
        ========================================== -->

        {gallery.length > 0 && (
            <section class="project-gallery">

                <div class="gallery-header">
                    <span>PROJECT GALLERY</span>
                    <div></div>
                </div>

                <div class="gallery-grid">

                    {gallery.map((item, index) => {
                        const src =
                            typeof item === 'string'
                                ? item
                                : item.src;

                        const alt =
                            typeof item === 'string'
                                ? ''
                                : item.alt || '';

                        const resolvedSrc = resolveAssetPath(src);

                        const isVideo =
                            /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(src);

                        return (
                            <figure class="gallery-item">

                                {isVideo ? (
                                    <video
                                        src={resolvedSrc}
                                        controls
                                        playsinline
                                        preload="metadata"
                                        aria-label={alt}
                                    />
                                ) : (
                                    <img
                                        src={resolvedSrc}
                                        alt={alt}
                                        loading="lazy"
                                    />
                                )}

                            </figure>
                        );
                    })}

                </div>

            </section>
        )}

    </div>


    <script>
        const base = import.meta.env.BASE_URL.endsWith('/')
            ? import.meta.env.BASE_URL
            : `${import.meta.env.BASE_URL}/`;

        function isExternal(url: string) {
            return /^(https?:|\/\/|mailto:|tel:|data:|#)/i.test(url);
        }

        function cleanPath(url: string) {
            return url
                .replace(/^(?:\.\.\/|\.\/)+/, '')
                .replace(/^public\//, '')
                .replace(/^\/+/, '');
        }

        function fixMedia() {
            document
                .querySelectorAll<HTMLImageElement | HTMLVideoElement | HTMLSourceElement>(
                    '.markdown-content img, .markdown-content video, .markdown-content source'
                )
                .forEach((element) => {

                    const src = element.getAttribute('src');

                    if (
                        src &&
                        !isExternal(src) &&
                        !src.startsWith(base)
                    ) {
                        element.setAttribute(
                            'src',
                            `${base}${cleanPath(src)}`
                        );
                    }

                });
        }

        function enhanceLists() {

            const lists = document.querySelectorAll(
                '.markdown-content ul'
            );

            lists.forEach((list) => {

                const items = Array.from(
                    list.children
                ) as HTMLLIElement[];

                if (items.length >= 2 && items.length <= 12) {

                    list.classList.add('feature-list');

                    items.forEach((item, index) => {

                        item.classList.add('feature-item');

                        const number = document.createElement('span');

                        number.className = 'feature-number';

                        number.textContent =
                            String(index + 1).padStart(2, '0');

                        const icon = document.createElement('span');

                        icon.className = 'feature-icon';

                        icon.innerHTML = '✦';

                        item.prepend(icon);
                    });
                }
            });
        }

        function enhanceHeadings() {

            const headings =
                document.querySelectorAll<HTMLHeadingElement>(
                    '.markdown-content h2'
                );

            headings.forEach((heading, index) => {

                const number = document.createElement('span');

                number.className = 'heading-number';

                number.textContent =
                    String(index + 1).padStart(2, '0');

                heading.prepend(number);
            });
        }

        fixMedia();
        enhanceLists();
        enhanceHeadings();
    </script>


    <style>

    /* ==================================================
    ROOT
    ================================================== */

    .project-page {
        width: min(1500px, 94vw);
        margin: 0 auto;
    }


    /* ==================================================
    HERO
    ================================================== */

    .hero {
        position: relative;
        min-height: 620px;
        margin-top: 1.5rem;
        overflow: hidden;
        border-radius: 2rem;
        border: 1px solid var(--gray-800);
        background: #080808;
        isolation: isolate;
    }

    .hero-video {
        position: absolute;
        inset: 0;
        z-index: -3;
    }

    .hero-video video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.75;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;

        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,0.95) 0%,
                rgba(0,0,0,0.78) 38%,
                rgba(0,0,0,0.25) 75%,
                rgba(0,0,0,0.65) 100%
            ),
            linear-gradient(
                0deg,
                rgba(0,0,0,0.8),
                transparent 50%
            );
    }

    .hero-scanline {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.08;

        background:
            repeating-linear-gradient(
                0deg,
                transparent,
                transparent 3px,
                rgba(255,255,255,0.08) 4px
            );
    }

    .hero-content {
        position: relative;
        z-index: 2;

        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-start;

        min-height: 620px;
        max-width: 800px;

        padding: clamp(2rem, 6vw, 6rem);
    }

    .hero-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.6rem;

        margin-bottom: 1.25rem;

        font-family: var(--font-brand);
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.18em;

        color: var(--gray-300);
    }

    .status-dot {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: var(--accent-dark);

        box-shadow:
            0 0 14px var(--accent-dark);
    }

    .hero h1 {
        margin: 0;

        max-width: 900px;

        font-size: clamp(3rem, 7vw, 7rem);
        line-height: 0.9;
        letter-spacing: -0.055em;
    }

    .hero-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

        margin-top: 1.75rem;
    }

    .hero-tag {
        padding: 0.45rem 0.8rem;

        border: 1px solid rgba(255,255,255,0.22);
        border-radius: 999px;

        background: rgba(0,0,0,0.45);

        backdrop-filter: blur(8px);

        font-family: var(--font-brand);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    .hero-description {
        max-width: 650px;

        margin: 1.25rem 0 0;

        color: var(--gray-200);

        font-size: clamp(1rem, 1.5vw, 1.25rem);
        line-height: 1.55;
    }

    .play-button {
        display: inline-flex;
        align-items: center;
        gap: 0.9rem;

        margin-top: 2rem;
        padding: 1rem 1.4rem;

        border-radius: 0.8rem;

        background: var(--accent-dark);
        color: var(--gray-0);

        border: 1px solid var(--accent-dark);

        font-family: var(--font-brand);
        font-weight: 900;
        letter-spacing: 0.04em;

        text-decoration: none;

        box-shadow:
            0 0 30px rgba(239,68,68,0.18);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .play-button:hover {
        transform: translateY(-3px);

        box-shadow:
            0 0 45px rgba(239,68,68,0.3);
    }

    .play-symbol {
        font-size: 0.8rem;
    }

    .arrow {
        font-size: 1.1rem;
    }


    /* ==================================================
    CORNER UI
    ================================================== */

    .hero-corner {
        position: absolute;

        width: 28px;
        height: 28px;

        border-color: rgba(255,255,255,0.5);

        z-index: 3;
    }

    .hero-corner-tl {
        top: 1.5rem;
        left: 1.5rem;

        border-top: 1px solid;
        border-left: 1px solid;
    }

    .hero-corner-tr {
        top: 1.5rem;
        right: 1.5rem;

        border-top: 1px solid;
        border-right: 1px solid;
    }

    .hero-corner-bl {
        bottom: 1.5rem;
        left: 1.5rem;

        border-bottom: 1px solid;
        border-left: 1px solid;
    }

    .hero-corner-br {
        bottom: 1.5rem;
        right: 1.5rem;

        border-bottom: 1px solid;
        border-right: 1px solid;
    }


    /* ==================================================
    METADATA
    ================================================== */

    .metadata {
        display: grid;

        grid-template-columns: repeat(4, 1fr);

        margin-top: 1rem;

        border: 1px solid var(--gray-800);
        border-radius: 1.25rem;

        overflow: hidden;

        background: var(--gradient-subtle);
    }

    .meta-item {
        position: relative;

        min-width: 0;

        padding: 1.4rem 1.5rem 1.5rem;

        border-right: 1px solid var(--gray-800);
    }

    .meta-item:last-child {
        border-right: none;
    }

    .meta-number {
        display: block;

        margin-bottom: 0.5rem;

        font-family: var(--font-brand);
        font-size: 0.65rem;
        font-weight: 900;

        color: var(--accent-dark);
    }

    .meta-label {
        display: block;

        margin-bottom: 0.4rem;

        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 0.15em;

        color: var(--gray-500);
    }

    .meta-item strong {
        display: block;

        font-family: var(--font-brand);
        font-size: 0.95rem;
        line-height: 1.3;
    }


    /* ==================================================
    FEATURED IMAGES
    ================================================== */

    .featured-images {
        display: grid;

        grid-template-columns: 1.35fr 1fr;

        gap: 1rem;

        margin-top: 1rem;
    }

    .featured-image {
        position: relative;

        margin: 0;

        overflow: hidden;

        border-radius: 1.5rem;

        border: 1px solid var(--gray-800);

        background: #090909;
    }

    .featured-image:first-child {
        grid-row: span 2;
    }

    .featured-image img {
        display: block;

        width: 100%;
        height: 100%;

        min-height: 300px;

        object-fit: cover;

        transition:
            transform 0.5s ease;
    }

    .featured-image:hover img {
        transform: scale(1.025);
    }

    .featured-image figcaption {
        position: absolute;

        left: 1rem;
        right: 1rem;
        bottom: 1rem;

        display: flex;
        align-items: center;

        gap: 0.6rem;

        padding: 0.65rem 0.8rem;

        border-radius: 0.6rem;

        background: rgba(0,0,0,0.72);

        backdrop-filter: blur(10px);

        font-size: 0.72rem;

        color: var(--gray-200);
    }

    .featured-image figcaption span {
        font-family: var(--font-brand);
        font-weight: 900;

        color: var(--accent-dark);
    }


    /* ==================================================
    CONTENT
    ================================================== */

    .project-content {
        padding: clamp(4rem, 8vw, 8rem) 0;
    }

    .content-inner {
        max-width: 850px;

        margin: 0 auto;
    }

    .content-marker {
        display: flex;
        align-items: center;

        gap: 1rem;

        margin-bottom: 3rem;
    }

    .content-marker span {
        font-family: var(--font-brand);

        font-size: 0.68rem;
        font-weight: 900;

        letter-spacing: 0.2em;

        color: var(--gray-500);
    }

    .content-marker div {
        flex: 1;

        height: 1px;

        background: var(--gray-800);
    }


    /* ==================================================
    MARKDOWN
    ================================================== */

    .markdown-content {
        font-size: 1.08rem;
        line-height: 1.75;
    }

    .markdown-content :global(h1) {
        display: none;
    }

    .markdown-content :global(h2) {
        position: relative;

        display: flex;
        align-items: center;

        gap: 0.8rem;

        margin: 5rem 0 1.5rem;

        padding-top: 1rem;

        font-size: clamp(2rem, 4vw, 3.2rem);

        line-height: 1;

        letter-spacing: -0.04em;
    }

    .heading-number {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        width: 2.2rem;
        height: 2.2rem;

        border-radius: 0.55rem;

        background: var(--accent-dark);

        color: var(--gray-0);

        font-family: var(--font-brand);

        font-size: 0.65rem;
        font-weight: 900;

        letter-spacing: 0;
    }

    .markdown-content :global(h3) {
        margin-top: 2.5rem;
        margin-bottom: 0.8rem;

        font-size: 1.35rem;
    }

    .markdown-content :global(p) {
        margin: 1.1rem 0;

        max-width: 70ch;
    }


    /* ==================================================
    FEATURE LISTS
    ================================================== */

    .markdown-content :global(ul.feature-list) {
        display: grid;

        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 0.8rem;

        padding: 0;

        margin: 2rem 0 3rem;

        list-style: none;
    }

    .markdown-content :global(li.feature-item) {
        position: relative;

        display: flex;
        align-items: center;

        min-height: 90px;

        margin: 0;

        padding: 1.25rem 1.25rem 1.25rem 3.5rem;

        overflow: hidden;

        border: 1px solid var(--gray-800);

        border-radius: 1rem;

        background:
            linear-gradient(
                135deg,
                rgba(224, 4, 4, 0.045),
                rgba(255, 59, 59, 0.015)
            );

        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.04);

        font-family: var(--font-brand);

        font-size: 0.95rem;
        font-weight: 800;

        line-height: 1.3;

        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }

    .markdown-content :global(li.feature-item)::after {
        content: '';

        position: absolute;

        right: -25px;
        bottom: -35px;

        width: 90px;
        height: 90px;

        border-radius: 50%;

        background: var(--accent-dark);

        opacity: 0.06;

        filter: blur(10px);

        transition:
            opacity 0.25s ease;
    }

    .markdown-content :global(li.feature-item:hover) {
        transform: translateY(-5px);

        border-color: var(--accent-dark);

        background:
            linear-gradient(
                135deg,
                rgba(239,68,68,0.09),
                rgba(255,255,255,0.025)
            );

        box-shadow:
            0 12px 30px rgba(0,0,0,0.18),
            0 0 25px rgba(239,68,68,0.07);
    }

    .markdown-content :global(li.feature-item:hover)::after {
        opacity: 0.14;
    }

    .feature-icon {
        position: absolute;

        left: 0.75rem;

        display: flex;
        align-items: center;
        justify-content: center;

        width: 2rem;
        height: 2rem;

        border: 1px solid var(--accent-dark);

        border-radius: 0.5rem;

        color: var(--accent-dark);

        font-size: 0.85rem;

        box-shadow:
            0 0 15px rgba(239,68,68,0.12);
    }

    .feature-number {
        position: absolute;

        top: 0.7rem;
        right: 0.8rem;

        font-size: 0.55rem;
        font-weight: 900;

        letter-spacing: 0.1em;

        color: var(--gray-600);
    }


    /* ==================================================
    BLOCKQUOTES
    ================================================== */

    .markdown-content :global(blockquote) {
        position: relative;

        margin: 3rem 0;

        padding: 1.7rem 2rem 1.7rem 2.5rem;

        overflow: hidden;

        border: 1px solid var(--gray-800);

        border-left: 4px solid var(--accent-dark);

        border-radius: 0 1rem 1rem 0;

        background:
            linear-gradient(
                110deg,
                rgba(239,68,68,0.09),
                rgba(255,255,255,0.02)
            );

        box-shadow:
            0 10px 35px rgba(0,0,0,0.12);
    }

    .markdown-content :global(blockquote)::before {
        content: '"';

        position: absolute;

        top: -1rem;
        right: 1.5rem;

        font-size: 6rem;
        line-height: 1;

        color: var(--accent-dark);

        opacity: 0.08;
    }

    .markdown-content :global(blockquote p) {
        position: relative;

        z-index: 1;

        margin: 0;

        font-family: var(--font-brand);

        font-size: 1.15rem;
        font-weight: 750;
    }


    /* ==================================================
    MEDIA
    ================================================== */

    .markdown-content :global(img),
    .markdown-content :global(video) {
        display: block;

        width: 100%;
        max-width: 100%;
        height: auto;

        margin: 2rem 0;

        border-radius: 1.25rem;

        border: 1px solid var(--gray-800);

        box-shadow: var(--shadow-md);
    }

    .markdown-content :global(video) {
        background: #050505;
    }


    /* ==================================================
    CODE
    ================================================== */

    .markdown-content :global(pre) {
        margin: 2rem 0;

        padding: 1.5rem;

        overflow-x: auto;

        border: 1px solid var(--gray-800);

        border-radius: 1rem;

        background: #080808;

        box-shadow:
            inset 0 0 30px rgba(239,68,68,0.035);
    }

    .markdown-content :global(code) {
        font-family:
            'JetBrains Mono',
            'Fira Code',
            monospace;

        font-size: 0.88rem;
    }


    /* ==================================================
    TABLE
    ================================================== */

    .markdown-content :global(table) {
        width: 100%;

        margin: 2rem 0;

        border-collapse: separate;

        border-spacing: 0;

        overflow: hidden;

        border: 1px solid var(--gray-800);

        border-radius: 1rem;
    }

    .markdown-content :global(th),
    .markdown-content :global(td) {
        padding: 1rem;

        text-align: left;

        border-bottom: 1px solid var(--gray-800);
    }

    .markdown-content :global(th) {
        font-family: var(--font-brand);

        font-weight: 900;
    }

    .markdown-content :global(tr:last-child td) {
        border-bottom: none;
    }


    /* ==================================================
    LINKS
    ================================================== */

    .markdown-content :global(a) {
        font-weight: 750;

        text-decoration-thickness: 1px;

        text-underline-offset: 0.25em;
    }


    /* ==================================================
    PROJECT GALLERY
    ================================================== */

    .project-gallery {
        margin-top: 2rem;

        padding-bottom: clamp(4rem, 8vw, 8rem);
    }

    .gallery-header {
        display: flex;

        align-items: center;

        gap: 1rem;

        margin-bottom: 1.5rem;
    }

    .gallery-header span {
        font-family: var(--font-brand);

        font-size: 0.68rem;

        font-weight: 900;

        letter-spacing: 0.2em;

        color: var(--gray-500);

        white-space: nowrap;
    }

    .gallery-header div {
        flex: 1;

        height: 1px;

        background: var(--gray-800);
    }

    .gallery-grid {
        display: grid;

        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 1rem;
    }

    .gallery-item {
        position: relative;

        margin: 0;

        overflow: hidden;

        border: 1px solid var(--gray-800);

        border-radius: 1.25rem;

        background: #080808;
    }

    .gallery-item img,
    .gallery-item video {
        display: block;

