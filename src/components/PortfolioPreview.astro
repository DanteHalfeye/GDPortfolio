---
import type { CollectionEntry } from 'astro:content';

interface Props {
    project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const data = project.data;

const base = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

function resolveAssetPath(path: string | undefined | null) {
    if (!path) return '';

    if (/^(https?:\/\/|mailto:|tel:|data:|#)/i.test(path)) {
        return path;
    }

    if (path.startsWith(base)) {
        return path;
    }

    const cleanPath = path
        .replace(/^(?:\.\.\/|\.\/)+/, '')
        .replace(/^public\//, '')
        .replace(/^\/+/, '');

    return `${base}${cleanPath}`;
}

const image = data.img
    ? resolveAssetPath(data.img)
    : '';

const heroVideo = data.heroVideo
    ? resolveAssetPath(data.heroVideo)
    : '';

const readMoreUrl = `${base}work/${project.id}/`;
const previewId = `preview-${project.id}`;

const role =
    data.role ||
    'GAMEPLAY PROGRAMMER';

const contributions =
    data.contributions ?? [];

const technicalHighlights =
    contributions.length > 0
        ? contributions
        : data.tags ?? [];

const modalHighlights =
    technicalHighlights.slice(0, 50);
---

<div class="portfolio-preview">

    <!-- ============================================================
         PROJECT CARD
         ============================================================ -->

    <button
        class="project-card"
        type="button"
        data-project-preview
        data-preview-id={previewId}
        aria-label={`Preview ${data.title}`}
    >
        <div class="card-media">
            {image && (
                <img
                    src={image}
                    alt={data.img_alt || data.title}
                    loading="lazy"
                    decoding="async"
                />
            )}
        </div>

        <div class="card-shade"></div>

        <div class="card-content">

            <!-- TOP -->

            <div class="card-top">

                <span class="card-role">
                    {role}
                </span>

                <span class="card-arrow">
                    ↗
                </span>

            </div>

            <!-- BOTTOM -->

            <div class="card-bottom">

                <h2>
                    {data.title}
                </h2>

                <p>
                    {data.description}
                </p>

                <div class="card-action">
                    <span>
                        VIEW PROJECT
                    </span>

                    <span>
                        →
                    </span>
                </div>

            </div>

        </div>
    </button>


    <!-- ============================================================
         PREVIEW MODAL
         ============================================================ -->

    <div
        class="preview-modal"
        id={previewId}
        data-preview-modal
        aria-hidden="true"
    >

        <div
            class="preview-backdrop"
            data-preview-close
        ></div>

        <div
            class="preview-box"
            role="dialog"
            aria-modal="true"
            aria-label={data.title}
        >

            <!-- CLOSE -->

            <button
                class="close-button"
                type="button"
                data-preview-close
                aria-label="Close preview"
            >
                ×
            </button>


            <!-- MEDIA -->

            <div class="preview-media">

                {image && (
                    <img
                        class="preview-poster"
                        src={image}
                        alt=""
                        aria-hidden="true"
                        loading="eager"
                        decoding="async"
                    />
                )}

                {heroVideo && (
                    <video
                        class="preview-video"
                        muted
                        loop
                        playsinline
                        preload="none"
                        data-video-src={heroVideo}
                    ></video>
                )}

                <div class="preview-video-shade"></div>

                <div class="preview-gradient"></div>

            </div>


            <!-- CONTENT -->

            <div class="preview-content">

                <div class="preview-inner">

                    <!-- ROLE -->

                    <div class="preview-role">

                        <span class="role-line"></span>

                        <span>
                            ROLE
                        </span>

                        <strong>
                            {role}
                        </strong>

                    </div>


                    <!-- TITLE -->

                    <h2>
                        {data.title}
                    </h2>


                    <!-- TECHNICAL HIGHLIGHTS -->

                    {modalHighlights.length > 0 && (

                        <div class="preview-contributions">

                            <span class="contributions-heading">
                                TECHNICAL HIGHLIGHTS
                            </span>

                            <div class="preview-highlight-grid">

                                {modalHighlights.map((item, index) => (

                                    <div
                                        class="preview-highlight"
                                        key={`${item}-${index}`}
                                    >

                                        <span class="highlight-number">
                                            {String(index + 1).padStart(2, '0')}
                                        </span>

                                        <span class="highlight-text">
                                            {item}
                                        </span>

                                    </div>

                                ))}

                            </div>

                        </div>

                    )}


                    <!-- DESCRIPTION -->

                    <p class="preview-description">
                        {data.description}
                    </p>


                    <!-- TAGS -->

                    {data.tags && data.tags.length > 0 && (

                        <div class="preview-tags">

                            {data.tags.slice(0, 5).map((tag) => (

                                <span
                                    class="preview-tag"
                                    key={tag}
                                >
                                    {tag}
                                </span>

                            ))}

                        </div>

                    )}


                    <!-- ACTIONS -->

                    <div class="preview-actions">

                        {data.playUrl && (

                            <a
                                class="play-button"
                                href={data.playUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >

                                <span>
                                    ▶
                                </span>

                                <span>
                                    PLAY PROJECT
                                </span>

                                <span>
                                    ↗
                                </span>

                            </a>

                        )}

                        <a
                            class="read-button"
                            href={readMoreUrl}
                        >

                            <span>
                                SEE FULL CASE STUDY
                            </span>

                            <span>
                                →
                            </span>

                        </a>

                    </div>

                </div>

            </div>


            <!-- CORNERS -->

            <div class="preview-corner preview-corner-tl"></div>
            <div class="preview-corner preview-corner-tr"></div>
            <div class="preview-corner preview-corner-bl"></div>
            <div class="preview-corner preview-corner-br"></div>

        </div>

    </div>

</div>


<script>
    document
        .querySelectorAll<HTMLElement>('[data-preview-modal]')
        .forEach((modal) => {
            if (modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
        });

    let activeModal: HTMLElement | null = null;
    let activeVideo: HTMLVideoElement | null = null;


    function stopVideo(modal: HTMLElement | null) {
        if (!modal) return;

        const video =
            modal.querySelector<HTMLVideoElement>(
                '.preview-video'
            );

        if (!video) return;

        video.pause();
        video.removeAttribute('src');
        video.load();

        video.classList.remove('is-ready');

        const poster =
            modal.querySelector<HTMLElement>(
                '.preview-poster'
            );

        if (poster) {
            poster.classList.remove('is-hidden');
        }

        if (activeVideo === video) {
            activeVideo = null;
        }
    }


    async function startVideo(modal: HTMLElement) {
        const video =
            modal.querySelector<HTMLVideoElement>(
                '.preview-video'
            );

        if (!video) return;

        if (
            activeVideo &&
            activeVideo !== video
        ) {
            activeVideo.pause();
            activeVideo.removeAttribute('src');
            activeVideo.load();
            activeVideo.classList.remove('is-ready');

            const previousModal =
                activeVideo.closest<HTMLElement>(
                    '.preview-modal'
                );

            const previousPoster =
                previousModal?.querySelector<HTMLElement>(
                    '.preview-poster'
                );

            if (previousPoster) {
                previousPoster.classList.remove(
                    'is-hidden'
                );
            }
        }

        activeVideo = video;

        const source =
            video.dataset.videoSrc;

        if (!source) return;

        video.src = source;
        video.muted = true;
        video.playsInline = true;
        video.loop = true;

        const revealVideo = () => {
            video.classList.add('is-ready');

            const poster =
                modal.querySelector<HTMLElement>(
                    '.preview-poster'
                );

            if (poster) {
                poster.classList.add('is-hidden');
            }
        };

        video.addEventListener(
            'loadeddata',
            revealVideo,
            { once: true }
        );

        video.addEventListener(
            'canplay',
            revealVideo,
            { once: true }
        );

        video.load();

        try {
            await video.play();
        } catch {
            /* Poster remains visible */
        }
    }


    function openModal(card: Element) {
        const previewId =
            card.getAttribute(
                'data-preview-id'
            );

        if (!previewId) return;

        const modal =
            document.getElementById(
                previewId
            ) as HTMLElement | null;

        if (!modal) return;

        if (
            activeModal &&
            activeModal !== modal
        ) {
            closeModal(activeModal);
        }

        activeModal = modal;

        modal.classList.add('is-open');

        modal.setAttribute(
            'aria-hidden',
            'false'
        );

        document.body.classList.add(
            'preview-open'
        );

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {

                if (
                    modal.classList.contains(
                        'is-open'
                    )
                ) {
                    startVideo(modal);
                }

            });
        });
    }


    function closeModal(
        modal: HTMLElement | null
    ) {
        if (!modal) return;

        stopVideo(modal);

        modal.classList.remove(
            'is-open'
        );

        modal.setAttribute(
            'aria-hidden',
            'true'
        );

        if (activeModal === modal) {
            activeModal = null;
        }

        document.body.classList.remove(
            'preview-open'
        );
    }


    document.addEventListener(
        'click',
        (event) => {

            const target = event.target;

            if (!(target instanceof Element)) {
                return;
            }

            const card =
                target.closest(
                    '[data-project-preview]'
                );

            if (!card) return;

            event.preventDefault();

            openModal(card);
        }
    );


    document.addEventListener(
        'click',
        (event) => {

            const target = event.target;

            if (!(target instanceof Element)) {
                return;
            }

            const closeButton =
                target.closest(
                    '[data-preview-close]'
                );

            if (!closeButton) return;

            const modal =
                closeButton.closest<HTMLElement>(
                    '[data-preview-modal]'
                );

            if (!modal) return;

            closeModal(modal);
        }
    );


    document.addEventListener(
        'keydown',
        (event) => {

            if (event.key !== 'Escape') {
                return;
            }

            if (activeModal) {
                closeModal(activeModal);
            }
        }
    );
</script>


<style>

    /* ============================================================
       FORCE WHITE TEXT
       ============================================================ */

    .project-card,
    .preview-modal,
    .preview-box {
        color: #fff;
    }

    .project-card h2,
    .project-card p,
    .project-card span,
    .preview-box h2,
    .preview-box p,
    .preview-box span,
    .preview-box a,
    .preview-box button {
        color: #fff;
    }


    /* ============================================================
       CARD
       ============================================================ */

    .portfolio-preview {
        position: static;
        width: 100%;
        min-width: 0;
    }

    .project-card {
        position: relative;
        display: block;
        width: 100%;
        min-height: 460px;
        padding: 0;
        overflow: hidden;

        border: 1px solid var(--gray-800);
        border-radius: 1.5rem;

        background: #080808;

        cursor: pointer;
        text-align: left;

        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease;

        contain: layout paint;
    }

    .project-card:hover {
        transform: translateY(-6px);

        border-color: var(--gray-600);

        box-shadow:
            0 20px 50px
            rgba(0, 0, 0, 0.3);
    }

    .project-card:focus-visible {
        outline:
            2px solid
            currentColor;

        outline-offset: 4px;
    }


    /* ============================================================
       CARD IMAGE
       ============================================================ */

    .card-media {
        position: absolute;
        inset: 0;

        overflow: hidden;

        z-index: 0;
    }

    .card-media img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        transition:
            transform 0.6s ease,
            filter 0.35s ease;
    }

    .project-card:hover .card-media img {
        transform: scale(1.035);

        filter: brightness(1.05);
    }


    /* ============================================================
       CARD SHADE
       ============================================================ */

    .card-shade {
        position: absolute;
        inset: 0;

        z-index: 1;

        background:
            linear-gradient(
                180deg,
                rgba(0, 0, 0, 0.08) 0%,
                rgba(0, 0, 0, 0.2) 35%,
                rgba(0, 0, 0, 0.96) 100%
            );
    }


    /* ============================================================
       CARD CONTENT
       ============================================================ */

    .card-content {
        position: absolute;
        inset: 0;

        z-index: 2;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        padding: 1.8rem;
    }


    /* ============================================================
       CARD TOP
       ============================================================ */

    .card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;

        gap: 1rem;
    }

    .card-role {
        max-width: 70%;

        font-family:
            var(--font-mono, monospace);

        font-size: 0.7rem;
        font-weight: 700;
        line-height: 1.4;

        letter-spacing: 0.12em;
        text-transform: uppercase;

        opacity: 0.72;

        overflow-wrap: anywhere;
    }

    .card-arrow {
        flex: 0 0 auto;

        display: flex;
        align-items: center;
        justify-content: center;

        width: 2.5rem;
        height: 2.5rem;

        border:
            1px solid
            rgba(
                255,
                255,
                255,
                0.24
            );

        border-radius: 50%;

        background:
            rgba(
                0,
                0,
                0,
                0.25
            );

        font-size: 1rem;

        transition:
            transform 0.25s ease,
            background 0.25s ease;
    }

    .project-card:hover .card-arrow {
        transform:
            translate(
                2px,
                -2px
            );

        background:
            rgba(
                255,
                255,
                255,
                0.12
            );
    }


    /* ============================================================
       CARD BOTTOM
       ============================================================ */

    .card-bottom {
        width: 100%;
        max-width: 720px;

        display: flex;
        flex-direction: column;
        align-items: flex-start;

        min-width: 0;
    }


    /* ============================================================
       CARD TITLE
       ============================================================ */

    .card-bottom h2 {
        width: 100%;

        margin: 0;

        font-size:
            clamp(
                2.8rem,
                5vw,
                4.8rem
            );

        line-height: 1.3	;

        letter-spacing:
            -0.055em;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* ============================================================
       CARD DESCRIPTION
       ============================================================ */

    .card-bottom p {
        width: 100%;
        max-width: 600px;

        margin:
            1rem 0 0;

        font-size: 0.95rem;
        line-height: 1.5;

        opacity: 0.72;

        display: -webkit-box;

        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;

        overflow: hidden;
    }


    /* ============================================================
       CARD ACTION
       ============================================================ */

    .card-action {
        display: flex;
        align-items: center;

        gap: 0.65rem;

        margin-top: 1.3rem;

        font-family:
            var(--font-mono, monospace);

        font-size: 0.68rem;
        font-weight: 700;

        letter-spacing: 0.13em;

        opacity: 0.68;

        transition:
            opacity 0.2s ease,
            transform 0.2s ease;
    }

    .project-card:hover .card-action {
        opacity: 1;

        transform:
            translateX(4px);
    }


    /* ============================================================
       MODAL
       ============================================================ */

    .preview-modal {
        position: fixed !important;
        inset: 0 !important;

        width: 100vw;
        height: 100vh;

        margin: 0 !important;
        padding: 2rem;

        box-sizing: border-box;

        z-index: 999999;

        display: flex;
        align-items: center;
        justify-content: center;

        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        transition:
            opacity 0.2s ease,
            visibility 0.2s ease;

        content-visibility: hidden;
    }

    .preview-modal.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;

        content-visibility: visible;
    }


    /* ============================================================
       BACKDROP
       ============================================================ */

    .preview-backdrop {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        background:
            rgba(
                0,
                0,
                0,
                0.88
            );
    }


    /* ============================================================
       MODAL BOX
       ============================================================ */

    .preview-box {
        position: relative;

        width:
            min(
                1250px,
                94vw
            );

        height:
            min(
                720px,
                88vh
            );

        overflow: hidden;

        border:
            1px solid
            var(--gray-700);

        border-radius: 2rem;

        background: #080808;

        box-shadow:
            0 30px 90px
            rgba(
                0,
                0,
                0,
                0.6
            );

        transform:
            scale(0.97)
            translateY(10px);

        transition:
            transform 0.25s ease;
    }

    .preview-modal.is-open
    .preview-box {
        transform:
            scale(1)
            translateY(0);
    }


    /* ============================================================
       MEDIA
       ============================================================ */

    .preview-media {
        position: absolute;
        inset: 0;

        overflow: hidden;

        z-index: 0;

        background: #050505;

        contain: paint;
    }

    .preview-poster {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        z-index: 0;

        opacity: 1;

        transition:
            opacity 0.2s ease;
    }

    .preview-poster.is-hidden {
        opacity: 0;
        visibility: hidden;
    }


    /* ============================================================
       VIDEO
       ============================================================ */

    .preview-video {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        z-index: 1;

        opacity: 0;

        transition:
            opacity 0.2s ease;
    }

    .preview-video.is-ready {
        opacity: 1;
    }


    /* ============================================================
       VIDEO SHADE
       ============================================================ */

    .preview-video-shade {
        position: absolute;
        inset: 0;

        z-index: 2;

        pointer-events: none;

        background:
            rgba(
                0,
                0,
                0,
                0.08
            );
    }


    /* ============================================================
       GRADIENT
       ============================================================ */

    .preview-gradient {
        position: absolute;
        inset: 0;

        z-index: 3;

        pointer-events: none;

        background:
            linear-gradient(
                90deg,
                rgba(0, 0, 0, 0.97) 0%,
                rgba(0, 0, 0, 0.82) 30%,
                rgba(0, 0, 0, 0.38) 65%,
                rgba(0, 0, 0, 0.1) 100%
            ),
            linear-gradient(
                0deg,
                rgba(0, 0, 0, 0.78) 0%,
                transparent 55%
            );
    }


    /* ============================================================
       MODAL CONTENT
       ============================================================ */

    .preview-content {
        position: relative;

        z-index: 4;

        width: 100%;
        height: 100%;

        box-sizing: border-box;

        padding:
            clamp(
                3rem,
                5vw,
                5rem
            );

        display: flex;
        align-items: flex-end;

        min-width: 0;

        /*
         * IMPORTANT:
         * The content itself is now a separate element.
         * This allows the entire block to move upward together
         * instead of individual elements getting clipped.
         */
        overflow: hidden;
    }

    .preview-inner {
        width: 100%;
        max-width: 900px;

        min-width: 0;

        display: flex;
        flex-direction: column;

        /*
         * Prevents the content from being pushed outside
         * the modal when there is a lot of information.
         */
        max-height: 100%;

        min-height: 0;
    }


    /* ============================================================
       ROLE
       ============================================================ */

    .preview-role {
        display: flex;
        align-items: center;

        flex-wrap: wrap;

        gap: 0.6rem;

        width: 100%;

        margin-bottom: 0.85rem;

        font-family:
            var(--font-mono, monospace);

        font-size: 0.68rem;
        font-weight: 700;

        line-height: 1.5;

        letter-spacing: 0.13em;

        text-transform: uppercase;

        opacity: 0.72;

        flex-shrink: 0;
    }

    .preview-role strong {
        max-width: 100%;

        font-weight: 800;

        overflow-wrap: anywhere;
    }

    .role-line {
        width: 32px;
        height: 1px;

        background:
            rgba(
                255,
                255,
                255,
                0.5
            );

        flex: 0 0 auto;
    }


    /* ============================================================
       MODAL TITLE
       ============================================================ */

    .preview-content h2 {
        width: 100%;
        max-width: 900px;

        margin: 0;

        font-size:
            clamp(
                2.5rem,
                6vw,
                6.2rem
            );

        line-height: 1.4;

        letter-spacing:
            -0.055em;

        /*
         * TITLE NEVER WRAPS
         */
        white-space: nowrap;

        overflow: hidden;

        text-overflow: ellipsis;

        flex-shrink: 1;
    }


    /* ============================================================
       TECHNICAL HIGHLIGHTS
       ============================================================ */

    .preview-contributions {
        display: flex;
        flex-direction: column;

        gap: 0.65rem;

        margin-top: 1.15rem;

        max-width: 820px;

        flex-shrink: 1;

        min-height: 0;
    }

    .contributions-heading {
        font-family:
            var(--font-mono, monospace);

        font-size: 0.68rem;
        font-weight: 800;

        line-height: 1;

        letter-spacing: 0.16em;

        opacity: 0.55;

        flex-shrink: 0;
    }

    .preview-highlight-grid {
        display: grid;

        grid-template-columns:
            repeat(
                2,
                minmax(
                    0,
                    1fr
                )
            );

        column-gap: 2.5rem;
        row-gap: 0.55rem;

        min-height: 0;
    }

    .preview-highlight {
        display: flex;
        align-items: flex-start;

        gap: 0.75rem;

        min-width: 0;
    }

    .highlight-number {
        flex: 0 0 auto;

        padding-top: 0.15rem;

        font-family:
            var(--font-mono, monospace);

        font-size: 0.62rem;

        line-height: 1;

        opacity: 0.35;
    }

    .highlight-text {
        font-size: 0.9rem;

        line-height: 2.35;

        font-weight: 600;

        letter-spacing: -0.01em;

        opacity: 0.9;

        overflow-wrap: anywhere;
    }


    /* ============================================================
       DESCRIPTION
       ============================================================ */

    .preview-description {
        width: 100%;
        max-width: 720px;

        margin:
            1.05rem 0 0;

        font-size: 0.95rem;

        line-height: 1.45;

        opacity: 0.72;

        /*
         * IMPORTANT:
         * Do NOT hide this with overflow when the modal
         * contains a lot of information.
         */
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;

    }


    /* ============================================================
